{
  "name": "mcp-market",
  "version": "0.2.0",
  "private": true,
  "description": "$MCP: an NFT market that lives inside AI chats. Open-source MCP server for Claude and ChatGPT.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "build": "node server/scripts/build.js",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "demo": "node --env-file-if-exists=.env server/scripts/demo-data.js",
    "smoke": "node server/scripts/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  },
  "engines": {
    "node": ">=22"
  }
}
